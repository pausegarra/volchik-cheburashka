---
interface CharacterCard {
  name: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
}

interface Props {
  title: string;
  characters: [CharacterCard, CharacterCard];
}

const { title, characters } = Astro.props;
---

<section class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
  <div class="px-1 py-10 sm:py-12 lg:py-14">
    <h2 class="mx-auto text-center text-[clamp(1.8rem,4.3vw,3rem)] font-semibold leading-tight tracking-tight text-[#1f2f49] text-balance">
      {title}
    </h2>

    <div class="mt-8 grid gap-10 lg:mt-10 lg:grid-cols-2 lg:gap-12">
      {characters.map((character, index) => {
        const isLeftColumn = index === 0;

        return (
        <article class="flex flex-col items-center text-center">
          <div class:list={[
            'flex w-full flex-col items-center gap-6 sm:flex-row sm:gap-8',
            isLeftColumn ? 'sm:flex-row' : 'sm:flex-row-reverse',
          ]}>
            <div class:list={[
              'flex-1 text-center sm:text-left',
              isLeftColumn ? 'sm:text-left' : 'sm:text-right',
            ]}>
              <p class="text-xs font-semibold uppercase tracking-[0.28em] text-[#f36c21]">
                {character.name}
              </p>
              <p class="mt-3 text-[1.02rem] leading-7 text-[#3f4d63] text-pretty">
                {character.description}
              </p>
            </div>

            <div class="relative flex flex-1 min-h-[18rem] w-full items-center justify-center sm:min-h-[22rem]">
              <img
                src={character.imageSrc}
                alt={character.imageAlt}
                class:list={[
                  'relative z-10 h-auto w-full max-w-[23rem] drop-shadow-[0_30px_36px_rgba(31,47,73,0.18)]',
                  isLeftColumn ? 'translate-y-1 sm:translate-y-2' : '-translate-y-1 sm:-translate-y-2',
                ]}
                loading="lazy"
              />
            </div>
          </div>
        </article>
        );
      })}
    </div>
  </div>
</section>
