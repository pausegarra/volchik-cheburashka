---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'ru';
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  alternates?: { lang: string; href: string }[];
}

const {
  title = 'Volchik & Cheburashka',
  description = 'Historias ilustradas de Volchik & Cheburashka.',
  lang = 'es',
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  ogImage = '/hero.webp',
  ogType = 'website',
  noindex = false,
  alternates = [],
} = Astro.props;

const ogImageAbsolute = new URL(ogImage, Astro.site).toString();
const robots = noindex ? 'noindex,follow' : 'index,follow';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />)}
    <meta property="og:site_name" content="Volchik & Cheburashka" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen antialiased">
    <div class="site-shell">
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <p class="site-footer-credit">Desarrollado por Pau Segarra</p>
        <a
          class="site-footer-link"
          href="https://github.com/pausegarra/volchik-cheburashka"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ver código en GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.18c-3.34.73-4.04-1.43-4.04-1.43-.55-1.38-1.33-1.75-1.33-1.75-1.08-.75.08-.74.08-.74 1.2.09 1.83 1.22 1.83 1.22 1.06 1.83 2.8 1.3 3.48 1 .11-.77.41-1.3.75-1.59-2.67-.3-5.46-1.33-5.46-5.9 0-1.3.47-2.37 1.22-3.2-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.22a11.44 11.44 0 0 1 6 0c2.3-1.54 3.3-1.22 3.3-1.22.65 1.65.24 2.87.12 3.17.76.83 1.22 1.9 1.22 3.2 0 4.58-2.8 5.6-5.48 5.9.42.36.8 1.07.8 2.16v3.2c0 .32.22.69.83.58A12 12 0 0 0 12 .5Z"
            ></path>
          </svg>
        </a>
      </footer>
    </div>
  </body>
</html>
